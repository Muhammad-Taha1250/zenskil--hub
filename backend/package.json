{
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.0.0",
    "@whiskeysockets/baileys": "^6.7.18",
    "@zenskill-hub/database": "file:../database",
    "age-encryption": "^0.3.1",
    "argon2": "^0.45.1",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.1.0",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "description": "ZenSkil Hub backend: NestJS API \u2014 deterministic order/payment/fulfillment core, WhatsApp ingress, AI tool boundary, admin RBAC.",
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/testing": "^11.1.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "jest": "^30.0.0",
    "prisma": "^6.0.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  },
  "license": "UNLICENSED",
  "name": "@zenskill-hub/backend",
  "private": true,
  "scripts": {
    "build": "nest build",
    "postinstall": "prisma generate",
    "lint": "tsc --noEmit -p tsconfig.json && echo 'lint: typecheck clean (eslint not configured yet)'",
    "prisma:generate": "prisma generate --schema ../database/prisma/schema.prisma",
    "start": "node dist/backend/src/main.js",
    "start:debug": "ts-node --transpile-only src/main.ts",
    "start:dev": "ts-node src/main.ts",
    "test": "jest --config test/jest.unit.json",
    "test:e2e": "tsc -p tsconfig.json && node dist/backend/tests/e2e-flow.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:whatsapp": "tsc -p tsconfig.json && node dist/backend/tests/whatsapp-flow.js",
    "test:n8n": "tsc -p tsconfig.json && node dist/backend/tests/n8n-flow.js",
    "test:workflows": "node tests/validate-workflows.mjs",
    "test:ai": "tsc -p tsconfig.json && node dist/backend/tests/ai-flow.js",
    "test:payments": "tsc -p tsconfig.json && node dist/backend/tests/payment-flow.js",
    "test:fulfillment": "tsc -p tsconfig.json && node dist/backend/tests/fulfillment-flow.js",
    "test:security": "npx tsx tests/security.ts",
    "test:staging": "tsc -p tsconfig.json && node dist/backend/tests/staging-flow.js",
    "start:prod": "node dist/backend/src/main.js"
  },
  "version": "0.3.0"
}
