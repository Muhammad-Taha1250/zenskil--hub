# ZenSkil Hub backend — environment template (Phase 3)
# Copy to .env for local work. NEVER commit real secrets.
# Production notes: JWT_SECRET must be >= 32 chars; DATABASE_URL must point
# at the production Postgres; never use the dev defaults below in production.

NODE_ENV="development"
PORT="3000"
LOG_LEVEL="info"

# --- Database (required; fail-fast at boot) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zenskill_dev"

# --- Auth (required in production; dev warns and uses an insecure default) ---
JWT_SECRET=""                 # >= 32 chars in production (HUMAN ACTION REQUIRED: generate)
JWT_EXPIRES_IN="15m"
TOTP_ENCRYPTION_KEY=""        # base64 of 32 random bytes; encrypts stored TOTP secrets

# --- API ---
API_PREFIX="api/v1"
CORS_ORIGINS="http://localhost:3001"
RATE_LIMIT_TTL_MS="60000"
RATE_LIMIT_MAX="100"

# --- WhatsApp via Baileys (WhatsApp Web socket; no Meta app/tokens needed) ---
# On first boot the server prints a QR code to the logs — scan it with the
# business phone's WhatsApp → Linked devices. BAILEYS_AUTH_DIR must persist
# across restarts (persistent disk) or the QR has to be re-scanned each boot.
BAILEYS_AUTH_DIR="./baileys_auth"
BAILEYS_LOG_LEVEL="warn"
WHATSAPP_MAX_PER_CUSTOMER_PER_HOUR="30"  # Phase 10: per-customer outbound WhatsApp cap

# --- AI provider (Phase 6; HUMAN ACTION REQUIRED: choose provider + model, store key) ---
AI_PROVIDER=""                # e.g. "openai" | "anthropic" — unset = deterministic fallback
AI_API_KEY=""
AI_MODEL=""
AI_BASE_URL=""                # override for OpenAI-compatible endpoints (Groq, Together, Ollama, vLLM)
AI_EMBEDDING_API_KEY=""      # unset = embeddings dormant, KB uses keyword search
AI_EMBEDDING_BASE_URL=""      # default https://api.openai.com/v1 (OpenAI-compatible /embeddings)
AI_EMBEDDING_MODEL=""
AI_EMBEDDING_DIMENSIONS="1536"   # must match the vector(1536) column

# --- Payments (Phase 7; HUMAN ACTION REQUIRED: gateway credentials) ---
PAYMENT_API_KEY=""
PAYMENT_WEBHOOK_SECRET=""
PAYMENT_WEBHOOK_SECRET_PREVIOUS=""  # Phase 10: rotation convention for future gateway providers (SECURITY.md §9)
PAYMENT_WINDOW_HOURS="24"     # manual-payment proof window

# --- Proof storage (Phase 3, local v1) ---
PROOF_STORAGE_DIR="./storage/proofs"   # 0700 dirs / 0600 files, <= 10 MB, jpg/png/webp/pdf
# HUMAN ACTION REQUIRED for production: private object storage + backup + credentials.

# --- Subscriptions / reminders ---
EXPIRY_GRACE_DAYS="3"
EXPIRING_SOON_DAYS="7"
RENEWAL_REMINDER_DAYS="3"
ABANDONED_REMINDER_HOURS="24"
TICKET_AUTO_CLOSE_DAYS="7"

# --- n8n automation (Phase 5) ---
# Shared secret n8n sends as the x-service-token header on /api/v1/automation/*,
# and the WhatsApp automation routes (GET /api/whatsapp/qr, POST /api/whatsapp/send;
# the QR page also accepts ?token= for browser use).
# If unset, ALL automation endpoints return 503 (closed by default).
AUTOMATION_SERVICE_TOKEN=<redacted>
# Cron schedules (node-cron syntax) for the in-process schedulers.
WHATSAPP_RETRY_CRON="*/2 * * * *"
SUBSCRIPTION_SWEEP_CRON="*/15 * * * *"
# Local pg_dump backups (maintenance endpoint + db-backup n8n workflow).
BACKUP_DIR="./storage/backups"
BACKUP_RETENTION_COUNT="7"
BACKUP_AGE_RECIPIENTS=""  # Phase 10 (T12): comma-separated age recipients (age1...) — backups are age-encrypted when set; plaintext + loud warning when unset
# Admin channel webhook for ticket alerts (Phase 6 outbox). The BACKEND posts
# here with retry (1m → 5m → 30m → 2h → 8h, then DEAD); n8n only triggers
# processing, it never delivers alerts itself.
ZENSKILL_ADMIN_ALERT_URL=""
