# ZenSkil Hub — environment template
# Copy to .env for local work. NEVER commit real secrets.

# --- Database (Phase 2) ---
DATABASE_URL="postgresql://zenskill:zenskill_dev@localhost:5432/zenskill_dev"

# --- WhatsApp via Baileys (WhatsApp Web socket; no Meta app/tokens needed) ---
# Pairing: scan the QR printed in the server logs on first boot with the
# business phone's WhatsApp → Linked devices. BAILEYS_AUTH_DIR must persist
# (Docker volume / Render disk); exactly one backend replica owns the session.
BAILEYS_AUTH_DIR="./baileys_auth"
BAILEYS_LOG_LEVEL="warn"

# --- AI provider (Phase 6; HUMAN ACTION REQUIRED) ---
AI_API_KEY=""
AI_CHAT_MODEL=""
AI_EMBEDDING_MODEL=""
AI_EMBEDDING_DIMENSIONS="1536"

# --- Payments (Phase 7; HUMAN ACTION REQUIRED for gateway) ---
PAYMENT_API_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# --- SMTP (optional) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# --- n8n ---
N8N_HOST="localhost"
N8N_PORT="5678"

# --- Backups ---
BACKUP_S3_ENDPOINT=""
BACKUP_S3_BUCKET=""
BACKUP_S3_ACCESS_KEY=""
BACKUP_S3_SECRET_KEY=""
