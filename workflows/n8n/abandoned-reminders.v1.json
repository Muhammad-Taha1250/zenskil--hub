      ]
    },
    "Send abandonment reminder": {
      "main": [
        [
          {
            "node": "Loop candidates",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Loop candidates",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
